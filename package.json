{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-ocr.mjs",
    "prebuild": "node scripts/prepare-ocr.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/precache.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:alerts": "node scripts/verify-alerts.cjs",
    "test:capture": "node scripts/verify-capture.cjs",
    "test:statements": "node scripts/verify-statements.cjs",
    "test:bank-pdf": "node scripts/verify-bank-pdf.cjs",
    "test:pdf-upload": "node scripts/verify-pdf-upload.mjs && node scripts/verify-pdf-upload.mjs --compat"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tesseract.js-data/eng": "1.0.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.446.0",
    "pdfjs-dist": "5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
