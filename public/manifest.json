{
  "name": "Finance Tracker",
  "short_name": "Finance",
  "description": "Quick expense tracking, receivables, and recurring payments",
  "start_url": "/",
  "share_target": {
    "action": "/share-statement",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"files": [{"name": "statement", "accept": ["application/pdf", ".pdf"]}]}
  },
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
